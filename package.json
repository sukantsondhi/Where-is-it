{
  "name": "where-is-it",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/build-config.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "test": "tsx --test tests/domain.test.ts",
    "test:invitations": "npm --prefix api run build && node --test tests/invitations.cjs",
    "test:e2e": "playwright test",
    "test:integration": "npm --prefix api run build && node tests/integration/cosmos.cjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "typescript": "^5.7.2",
    "vite": "^6.4.5",
    "tsx": "^4.19.2",
    "@playwright/test": "^1.49.1"
  }
}
